<import name="header-bar" src="../../components/header-bar.ux"></import>
<import name="detail-modal" src="../../components/detail-modal.ux"></import>
<import name="manage-modal" src="../../components/manage-modal.ux"></import>
<import name="layout-picker" src="../../components/layout-picker.ux"></import>

<template>
  <div class="container-{{deviceMode}}">
    <layout-picker 
      if="{{showPicker}}" 
      onselect="handlePickerSelect"> 
    </layout-picker>

    <block if="{{!showPicker && deviceMode}}">
      <div class="header-click-area-{{deviceMode}}" onclick="switchMode" onlongpress="triggerPicker">
        <header-bar 
          device-mode="{{deviceMode}}"
          mode-index="{{currentModeIndex}}" 
          countdown="{{countdown}}" 
          time="{{statusMsg}}">
        </header-bar>
      </div>
      
      <div class="scroll-wrapper-{{deviceMode}}">
        <list class="coin-list-{{deviceMode}}">
          <block for="{{coins}}">
            <list-item type="coin" if="{{$item.selected}}" class="coin-row-{{deviceMode}}" onclick="openDetail($item)">
              <div class="left-container">
                <image class="coin-icon-{{deviceMode}}" src="{{$item.icon}}"></image>
                <text class="name-{{deviceMode}}">{{$item.name}}</text>
              </div>
              <div class="price-container-{{deviceMode}}">
                <text class="price-{{deviceMode}}" style="color: {{$item.change > 0 ? '#00ff00' : ($item.change < 0 ? '#ff4444' : '#ffffff')}}">{{$item.price}}</text>
                <div class="change-box-{{deviceMode}}">
                  <text class="arrow-{{deviceMode}}" style="color: {{$item.change > 0 ? '#00ff00' : ($item.change < 0 ? '#ff4444' : '#ffffff')}}">{{$item.change > 0 ? '↑' : ($item.change < 0 ? '↓' : '')}}</text>
                  <text class="change-text-{{deviceMode}}" style="color: {{$item.change > 0 ? '#00ff00' : ($item.change < 0 ? '#ff4444' : '#ffffff')}}">{{$item.change}}%</text>
                </div>
              </div>
            </list-item>
          </block>
          
          <list-item type="manage" class="manage-btn-row-{{deviceMode}}" onclick="showManageModal">
            <image class="settings-icon-{{deviceMode}}" src="/common/settings.png"></image>
          </list-item>
        </list>
      </div>

      <div class="footer-zen-{{deviceMode}}" onclick="manualRefresh">
        <text class="zen-text-{{deviceMode}}">盈亏同源 · 戒骄戒躁</text>
      </div>

      <block if="{{showDetail}}">
        <div class="modal-wrapper-{{deviceMode}}">
          <detail-modal 
            coin="{{activeCoin}}" 
            closecallback="{{closeDetail.bind(this)}}">
          </detail-modal>
        </div>
      </block>

      <block if="{{showManage}}">
        <div class="modal-wrapper-{{deviceMode}}"> 
          <manage-modal 
            coins="{{coins}}" 
            closecallback="{{closeManage.bind(this)}}">
          </manage-modal>
        </div>
      </block>
    </block>
  </div>
</template>

<style>@import '../../common/market.css';</style>

<script>
import brightness from '@system.brightness';
import vibrator from '@system.vibrator';
import prompt from '@system.prompt';
import storage from '@system.storage';
import apiService from '../../common/api.js';
import configManager from '../../common/config.js';
import { DEFAULT_COINS, APP_MODES } from '../../common/constants.js';

export default {
  data: {
    statusMsg: '--:--',
    countdown: 60,
    currentModeIndex: 0,
    showDetail: false,
    showManage: false,
    showPicker: false,
    activeCoin: {},
    modes: APP_MODES,
    coins: DEFAULT_COINS,
    timer: null,
    deviceMode: '' 
  },

  onInit() {
    this.initDeviceMode();
  },

  initDeviceMode() {
    const self = this;
    storage.get({
      key: 'DEVICE_MODE',
      success: function(data) {
        if (data) {
          self.deviceMode = data;
          self.bootApp();
        } else {
          self.showPicker = true;
        }
      },
      fail: function() {
        self.showPicker = true;
      }
    });
  },

  triggerPicker() {
    vibrator.vibrate({ mode: 'long' });
    this.showPicker = true;
  },

  handlePickerSelect(e) {
    const mode = e.detail.mode;
    this.deviceMode = mode;
    this.showPicker = false;
    storage.set({ key: 'DEVICE_MODE', value: mode });
    this.bootApp();
  },

  bootApp() {
    this.loadConfig();
    this.startMasterTimer();
  },

  loadConfig() {
    configManager.load(this.coins, (merged) => {
      this.coins = merged;
      this.refreshAll();
    });
  },

  saveConfig() {
    configManager.save(this.coins);
  },

  showManageModal() {
    vibrator.vibrate({ mode: 'short' });
    this.showManage = true;
  },

  closeManage(updatedCoins) {
    this.showManage = false;
    if (updatedCoins && Array.isArray(updatedCoins)) { 
      this.coins = updatedCoins; 
      this.saveConfig();
      vibrator.vibrate({ mode: 'long' });
    }
    setTimeout(() => {
      this.countdown = this.modes[this.currentModeIndex].value;
      this.refreshAll();
    }, 800);
  },

  openDetail(item) {
    this.activeCoin = item;
    this.showDetail = true;
    vibrator.vibrate({ mode: 'short' });
  },

  closeDetail() { this.showDetail = false; },

  switchMode() {
    this.currentModeIndex = (this.currentModeIndex + 1) % this.modes.length;
    this.countdown = this.modes[this.currentModeIndex].value;
    vibrator.vibrate({ mode: (this.currentModeIndex === 2 ? 'long' : 'short') });
    brightness.setKeepScreenOn({ keepScreenOn: (this.currentModeIndex === 2) });
    if (this.currentModeIndex === 2) prompt.showToast({ message: '疯狂模式！屏幕常亮！' });
  },

  manualRefresh() {
    vibrator.vibrate({ mode: 'short' });
    this.refreshAll();
    this.countdown = this.modes[this.currentModeIndex].value;
  },

  startMasterTimer() {
    if (this.timer) clearInterval(this.timer);
    this.timer = setInterval(() => {
      const now = new Date();
      this.statusMsg = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      if (this.showManage || this.showDetail || this.showPicker) return;
      if (this.countdown > 0) {
        this.countdown--;
      } else {
        this.refreshAll();
        this.countdown = this.modes[this.currentModeIndex].value;
      }
    }, 1000);
  },

  refreshAll() {
    if (this.showManage || this.showPicker) return;
    apiService.updateAll(this.coins, (updatedItem) => {
      const idx = this.coins.findIndex(c => c.id === updatedItem.id);
      if (idx !== -1 && this.coins[idx].price !== updatedItem.price) {
        this.coins.splice(idx, 1, updatedItem);
      }
    });
  }
}
</script>