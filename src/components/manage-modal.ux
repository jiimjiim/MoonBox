<template>
  <div class="manage-mask-dark">
    <div class="manage-card-clean" onclick="stopProp">
      <div class="screen-adapter-top"></div>
      
      <text class="manage-hint">点击开关 · 长按置顶</text>

      <div class="clean-btc-row" onclick="toggleSelect(0)" onlongpress="moveToTop(0)">
        <text class="grid-text-large" style="color: {{coins[0].selected ? '#ff9900' : '#444444'}}">{{coins[0].name}}</text>
      </div>

      <div class="clean-grid-box">
        <block for="{{coins}}">
          <div class="clean-grid-item" if="{{$idx > 0}}" 
               onclick="toggleSelect($idx)" 
               onlongpress="moveToTop($idx)">
            <text class="grid-text-small" style="color: {{$item.selected ? '#ff9900' : '#444444'}}">{{$item.name}}</text>
          </div>
        </block>
      </div>
      
      <div class="flex-spacer"></div>
    </div>

    <div class="manage-footer-bar" onclick="handleBack">
      <text class="footer-title">保存</text>
    </div>
  </div>
</template>

<style>
  .manage-mask-dark {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: #000000;
    flex-direction: column;
    align-items: center;
    z-index: 300;
  }

  .manage-card-clean {
    width: 280px;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .screen-adapter-top { height: 35px; } /* 顶部留白 */
  .flex-spacer { flex-grow: 1; }

  .manage-hint { color: #444444; font-size: 24px; margin-bottom: 25px; }

  .clean-btc-row { width: 240px; height: 40px; justify-content: center; align-items: center; margin-bottom: 15px; }
  .clean-grid-box { width: 280px; flex-wrap: wrap; justify-content: space-around; }
  .clean-grid-item { width: 90px; height: 68px; justify-content: center; align-items: center; margin-bottom: 8px; }

  .grid-text-large { font-size: 29px; font-weight: bold; }
  .grid-text-small { font-size: 23px; font-weight: bold; }

  /* 极简底栏：完全纯黑，靠高度确保点击热区 */
  .manage-footer-bar {
    width: 336px;
    height: 90px; /* 适当增加高度，方便大拇指点击 */
    background-color: #000000;
    justify-content: center;
    align-items: center;
  }

  .footer-title {
    color: #ff9900;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 4px; /* 增加字间距，更有仪式感 */
    opacity: 0.9;
  }
</style>

<script>
  import vibrator from '@system.vibrator';

  export default {
    props: ['coins', 'closecallback'],

    stopProp(e) {
      if (e && e.stopPropagation) { e.stopPropagation(); }
    },

    toggleSelect(idx) {
      vibrator.vibrate({ mode: 'short' });
      this.coins[idx].selected = !this.coins[idx].selected;
      this.coins.splice(idx, 1, this.coins[idx]);
    },

    moveToTop(idx) {
      if (idx === 0) return;
      vibrator.vibrate({ mode: 'long' });
      const item = this.coins.splice(idx, 1)[0];
      this.coins.unshift(item);
    },

    handleBack() {
      if (this.closecallback) {
        this.closecallback(this.coins);
      }
    }
  }
</script>